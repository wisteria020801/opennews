# OpenNews Matrix Environment Variables
# Copy this to .env and fill in your values

# Telegram Bot Token (required)
BOT_TOKEN_G=your_telegram_bot_token_here

# Gemini API Key (required for AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Chat ID (optional, defaults to -1003590230315)
CHAT_ID_G=-1003590230315
